SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
#SHOPIFY_APP_URL=https://your-app-url.com
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_customers,write_customers,read_orders,write_discounts,read_discounts,read_products
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/loyalty-rewards
NODE_ENV=development
PORT=3456

# Admin panel (/admin)
# Create the first admin explicitly — there is no default account:
#   node scripts/create-admin.mjs you@example.com super_admin
#
# Signs admin session cookies. REQUIRED, minimum 32 chars, no fallback.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Encrypts stored Shopify access tokens. REQUIRED, 32 bytes base64, no fallback.
# Must be distinct from SHOPIFY_API_SECRET (key separation).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# SMTP Email (for spin wheel prize emails)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_from_address

# ElevenLabs voice agent. REQUIRED for the voice webhook — it rejects all
# requests when unset rather than accepting unsigned callbacks.
ELEVENLABS_WEBHOOK_SECRET=
